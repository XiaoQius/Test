# Required in production. Use a long random value.
ADMIN_TOKEN=change-me

# Optional but recommended for Vercel admin persistence.
# Vercel Marketplace Redis/Upstash may inject one of these variable groups.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_REST_API_URL=
REDIS_REST_API_TOKEN=
PROFILE_KV_KEY=profile
